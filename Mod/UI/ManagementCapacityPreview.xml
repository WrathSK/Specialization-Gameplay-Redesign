<?xml version="1.0" encoding="utf-8"?>
<Context Name="SPCManagementCapacityPreview" ColorSet="BodyTextCool" FontStyle="Shadow">
  <!-- Only the two HUD controls are reparented. The preview window stays in its own context. -->
  <Container ID="Parking" Hidden="1">
    <Grid ID="Readout" Style="SubContainerSmall2" Size="65,24" ToolTip="LOC_SPC_CAP_PREVIEW_HINT">
      <Image Anchor="L,C" Size="22,22" Icon="ICON_DISTRICT_GOVERNMENT" IconSize="22"/>
      <Label ID="HUDCount" Anchor="L,C" Offset="24,0" Style="FontNormal14" ColorSet="TopBarValueCS"/>
    </Grid>
    <Container ID="LaunchItem" Size="56,49">
      <Button ID="OpenButton" Anchor="L,C" Size="49,49" Texture="LaunchBar_Hook_GovernmentButton" Style="ButtonNormalText" StateOffsetIncrement="0,49" ToolTip="LOC_SPC_CAP_PREVIEW_HINT">
        <Image Anchor="C,C" Size="32,32" Icon="ICON_DISTRICT_GOVERNMENT" IconSize="32"/>
      </Button>
      <Image Anchor="R,C" Offset="0,-2" Size="7,7" Texture="LaunchBar_TrackPip" Color="255,255,255,200"/>
    </Container>
  </Container>

  <Container ID="Backdrop" Style="FullScreenVignetteConsumer" Hidden="1"/>
  <Container ID="Window" Anchor="C,C" Size="1024,768" Hidden="1">
    <Container Style="ModalScreenWide"/>
    <Grid Offset="0,40" Size="parent,32" Texture="Governors_SubHeaderTile" SliceCorner="128,2" SliceTextureSize="0,40">
      <Label ID="Available" Anchor="L,C" Offset="28,0" Style="FontNormal16" Color="238,228,197,255"/>
      <Label Anchor="C,C" Style="FontNormal14" Color="200,190,165,255" String="LOC_SPC_CAP_PREVIEW_NOTE"/>
      <Label ID="Total" Anchor="R,C" Offset="28,0" Style="FontNormal16" Color="238,228,197,255"/>
    </Grid>

    <!-- One row per city: emblem card, then levels I-IV laid out like the governor promotion tree. -->
    <ScrollPanel ID="CityScroll" Anchor="C,T" Offset="0,92" Size="1000,600" Vertical="1" AutoScrollBar="1">
      <ScrollBar Anchor="R,C" AnchorSide="O,I" Offset="2,0" Size="8,parent" Style="ScrollVerticalBar"/>
      <Stack ID="Cities" Anchor="C,T" StackGrowth="Bottom" StackPadding="12"/>
    </ScrollPanel>

    <Image Anchor="C,B" Size="parent,52" Texture="Governors_DetailsFooterTile" StretchMode="TileX">
      <Stack Anchor="C,C" StackGrowth="Right" StackPadding="8">
        <Image Texture="Governors_PromotionScreen_DecoLeft" Size="184,42" Color="0,0,0,50"/>
        <GridButton ID="Undo" Anchor="C,C" Style="Grid9MainButton" Size="200,30">
          <Label Anchor="C,C" Style="FontNormal14" String="LOC_SPC_CAP_UNDO"/>
        </GridButton>
        <GridButton ID="Confirm" Anchor="C,C" Style="Grid9ConfirmButton" Size="200,30">
          <Label Anchor="C,C" Style="FontNormal14" String="LOC_SPC_CAP_CONFIRM"/>
        </GridButton>
        <Image Texture="Governors_PromotionScreen_DecoRight" Size="184,42" Color="0,0,0,50"/>
      </Stack>
    </Image>
  </Container>

  <Instance Name="CapacityCityRow">
    <Container ID="Root" Size="980,121">
      <!-- Tree path segments sit behind the level slots. -->
      <Image Anchor="L,C" Offset="398,0" Size="40,40" Texture="Controls_TreePathDashEW" Color="108,105,86,255"/>
      <Image Anchor="L,C" Offset="588,0" Size="40,40" Texture="Controls_TreePathDashEW" Color="108,105,86,255"/>
      <Image Anchor="L,C" Offset="778,0" Size="40,40" Texture="Controls_TreePathDashEW" Color="108,105,86,255"/>
      <Image Anchor="L,C" Offset="211,0" Size="40,40" Texture="Controls_TreePathDashEW" Color="108,105,86,255"/>

      <Grid Size="226,121" Texture="Governors_DataFrame" SliceCorner="10,10" SliceSize="8,8">
        <Image ID="Emblem" Offset="8,8" Size="50,50"/>
        <Label ID="Name" Offset="66,12" Style="FontFlair16" SmallCaps="20" SmallCapsType="EveryWord" FontStyle="Shadow" Color0="240,230,199,255" Color1="0,0,0,50" TruncateWidth="150" TruncatedTooltip="1"/>
        <Label ID="Title" Offset="66,36" Style="FontNormal14" Color="220,205,173,255" TruncateWidth="150" TruncatedTooltip="1"/>
        <Label ID="Status" Anchor="C,T" Offset="0,64" Style="FontNormal12" Color="200,200,200,255" TruncateWidth="210" TruncatedTooltip="1"/>
        <Container Anchor="C,B" Offset="0,6" Size="130,34" ToolTip="LOC_SPC_CAP_AMOUNT_HINT">
          <Grid Anchor="C,C" Texture="Controls_WindowLight" SliceTextureSize="34,34" SliceCorner="17,17" Size="parent-30,34">
            <Grid Anchor="C,C" Texture="Controls_TextArea" SliceTextureSize="22,22" SliceCorner="11,20" Size="parent-20,24">
              <Label ID="Points" Anchor="C,C" Style="FontNormalBold16" FontStyle="Stroke"/>
              <Button ID="Minus" Style="ArrowButtonLeft" Anchor="L,C" AnchorSide="O,I"/>
              <Button ID="Plus" Style="ArrowButtonRight" Anchor="R,C" AnchorSide="O,I"/>
            </Grid>
          </Grid>
        </Container>
      </Grid>

      <Stack ID="Levels" Offset="236,0" StackGrowth="Right" StackPadding="16"/>
    </Container>
  </Instance>

  <!-- Display-only slot using the governor promotion button states. -->
  <Instance Name="CapacityLevelSlot">
    <GridButton ID="Slot" Size="174,121" Texture="Governors_Promotion_Button" Padding="0,0" StateOffsetIncrement="0,121" SliceCorner="90,42" SliceTextureSize="174,121">
      <Label ID="LevelName" Offset="10,10" Style="FontFlair14" SmallCaps="16" SmallCapsType="FirstWord" FontStyle="Shadow" Color0="245,245,245,255" Color1="0,0,0,70"/>
      <Label ID="LevelState" Offset="10,36" Style="FontNormal12" FontStyle="Shadow" Color0="240,240,240,255" Color1="0,0,0,150" WrapWidth="152"/>
    </GridButton>
  </Instance>
</Context>
